# PLACEHOLDERS ONLY. Never put real values in this file or any file in the repo.
#
# The real values belong in Trigger.dev:
#   Project Settings > Environment Variables > (Production / Staging)
#
# RunPod reads them at runtime via process.env inside the task.

RUNPOD_API_KEY=rp_REPLACE_ME
RUNPOD_ENDPOINT_ID=REPLACE_WITH_ENDPOINT_ID

# Optional. Leave unset in production; the client defaults to https://api.runpod.ai.
# Only used to point the integration tests at the local mock server.
# RUNPOD_BASE_URL=
